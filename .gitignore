# credenciales — NUNCA se commitea
.env
.env.*

node_modules/
dist/
*.tsbuildinfo

# caché de las herramientas
.cache/
# restos locales de fal.ai, retirado el 06-11-2026 (su caché y su gasto)
tools/gen/

# Borradores de la arena (las formas de muralla que se dibujan en ella,
# `data/borradores/murallas.json`): son de quien la usa, no del repositorio.
data/borradores/

# saves de partidas
saves/

# preferencias personales de Claude Code (las de equipo sí van en settings.json)
.claude/settings.local.json

# andamio del ciclo de agentes: a los tres meses es documentación falsa.
# requisitos.md, critica.md y qa.md SÍ se commitean: envejecen bien.
docs/agents/*/plan*.md
docs/agents/*/implementacion*.md
# Los parches existen para repartir los commits; en cuanto los commits existen,
# el historial de git los cuenta mejor. Y llevan dentro lo que el commit quita
# —incluida una ruta absoluta, cuando eso es justo lo que se está quitando—.
docs/agents/*/commits/
# Capturas de pnpm capturas y de QA: se regeneran, pesan decenas de MB
docs/agents/*/capturas/
docs/agents/*/qa/
# Borrador de diseño del usuario: decidió no versionarlo (02-10-2026)
NuevaJugabilidad.md
NuevaJugabilidad.md.backup

# Marcas de fallo del mapa (pnpm dev → «Marcar»): bandeja de entrada de la
# revisión, la leen y resuelven `pnpm marcas` y el coordinador.
docs/revision/

# Los mundos que genera el servidor de desarrollo desde el menú (F1a del mapa
# vivo): se juegan con ?mundo=<id> en esta máquina. Solo «prueba» y «ejemplo» se
# commitean.
assets/mundos/gen-*/

# El entorno de visión de la revisión de animaciones (tools/taller/revision/*.py)
__pycache__/
