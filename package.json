{
  "name": "heroes-of-silence",
  "version": "0.1.0",
  "description": "Clon de Heroes of Might and Magic 2 en el navegador, con NPCs, mapas y assets generados por IA.",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mirar": "vite --open /espectador/",
    "arena": "vite --open /arena/",
    "build": "tsc -b --noEmit && vite build",
    "test": "vitest run",
    "test:lento": "HEROES_LENTO=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "partida": "tsx src/server/ws-server.ts",
    "mcp": "tsx src/server/mcp/server.ts",
    "gen": "tsx tools/gen/cli.ts",
    "taller": "tsx tools/taller/trabajador.ts",
    "qa": "tsx tools/qa/verify-agent.ts",
    "capturas": "tsx tools/qa/capturas.ts",
    "banco": "tsx tools/qa/banco.ts",
    "marcas": "tsx tools/marcas/cli.ts",
    "mundo": "tsx tools/mundo/cli.ts",
    "npcs": "tsx tools/npcs/cli.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:lento": "pnpm typecheck && pnpm lint && pnpm test:lento"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "zod-to-json-schema": "3.25.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
